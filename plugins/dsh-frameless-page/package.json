{
  "name": "dsh-frameless-page",
  "version": "0.1.23",
  "description": "为 DSH-Portable 窗口加入顶部居中的灵动岛胶囊：拖动/窗口控制/原生菜单，可切换回原生标题栏 UI。",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "frameless",
    "floating-window",
    "gravity"
  ],
  "type": "module",
  "main": "./lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json",
    "./locale/*": "./locale/*"
  },
  "files": [
    "lib",
    "locale",
    "assets",
    "cordis.patch.yml",
    "README.md",
    "README.en.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-layout"
      ],
      "platform": "web"
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": ">=4.0.1",
    "react": "^18.2.0"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/cordis": {
      "optional": true
    },
    "react": {
      "optional": true
    }
  },
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "scripts": {
    "build": "node scripts/build-client.mjs",
    "test": "node scripts/smoke.mjs"
  },
  "author": "DSH-Portable workspace",
  "license": "MIT"
}
