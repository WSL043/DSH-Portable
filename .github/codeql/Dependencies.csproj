<Project Sdk="Microsoft.NET.Sdk">
  <!-- Dependency metadata for CodeQL's build-mode:none on Linux.
       Product binaries still use scripts/build-windows.ps1 and upstream.lock.json. -->
  <PropertyGroup>
    <TargetFramework>net48</TargetFramework>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="../../launcher/windows/**/*.cs;../../experiments/**/*.cs" />
    <Reference Include="System.Drawing;System.Windows.Forms;System.Web.Extensions;System.Net.Http;System.Runtime.Serialization;System.IO.Compression;System.IO.Compression.FileSystem" />
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies.net48" Version="1.0.3" PrivateAssets="all" />
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.4078.44" />
    <PackageReference Include="Microsoft.Toolkit.Uwp.Notifications" Version="7.1.3" />
    <PackageReference Include="System.ValueTuple" Version="4.5.0" />
    <PackageReference Include="Microsoft.Windows.SDK.Contracts" Version="10.0.19041.1" />
  </ItemGroup>
</Project>
