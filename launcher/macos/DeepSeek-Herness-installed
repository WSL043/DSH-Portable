#!/bin/zsh
set -u

SCRIPT_DIR="$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)"
APP_ROOT="$(CDPATH= cd -- "$SCRIPT_DIR/../.." && pwd)"
RESOURCES="$APP_ROOT/Contents/Resources"
NODE="$RESOURCES/runtime/node/bin/node"
CLI="$RESOURCES/launcher/portable-cli.mjs"

if [[ ! -x "$NODE" || ! -f "$CLI" ]]; then
  export DSH_PORTABLE_ERROR="DeepSeek-Herness is incomplete. Reinstall the application."
  /usr/bin/osascript -e 'display dialog (system attribute "DSH_PORTABLE_ERROR") with title "DeepSeek-Herness" buttons {"Close"} default button "Close" with icon stop'
  exit 1
fi

if [[ -z "${DSH_PORTABLE_STATE_ROOT:-}" ]]; then
  export DSH_PORTABLE_STATE_ROOT="$HOME/Library/Application Support/DeepSeek-Herness"
fi

json_value() {
  "$NODE" -e 'try { const value = JSON.parse(process.argv[1])[process.argv[2]]; if (value != null) process.stdout.write(String(value)); } catch {}' "$1" "$2"
}

if [[ "${DSH_PORTABLE_NO_BROWSER:-0}" != "1" ]]; then
  CHECK_OUTPUT="$("$NODE" "$CLI" check-update --json 2>/dev/null || true)"
  UPDATE_STATUS="$(json_value "$CHECK_OUTPUT" status)"
  UPDATE_VERSION="$(json_value "$CHECK_OUTPUT" latest)"
  if [[ "$UPDATE_STATUS" == "available" || "$UPDATE_STATUS" == "full-package-required" ]]; then
    export DSH_UPDATE_BODY="发现 DeepSeek-Herness $UPDATE_VERSION。安装版需要用新版 DMG 完整替换，以保持应用签名有效；设置、会话和工作区不会被覆盖。"
    CHOICE="$(/usr/bin/osascript <<'APPLESCRIPT'
try
  set response to display dialog (system attribute "DSH_UPDATE_BODY") with title "DeepSeek-Herness 更新" buttons {"稍后", "打开下载页"} default button "打开下载页" cancel button "稍后"
  return button returned of response
on error number -128
  return "稍后"
end try
APPLESCRIPT
)"
    "$NODE" "$CLI" defer-update --json >/dev/null 2>&1 || true
    if [[ "$CHOICE" == "打开下载页" ]]; then
      /usr/bin/open "https://github.com/WSL043/DSH-Portable/releases/latest"
    fi
  fi
fi

CLI_ARGS=(start)
if [[ "${DSH_PORTABLE_NO_BROWSER:-0}" == "1" ]]; then
  CLI_ARGS+=(--no-browser --json)
fi
OUTPUT="$("$NODE" "$CLI" "${CLI_ARGS[@]}" 2>&1)"
STATUS=$?
if [[ $STATUS -ne 0 ]]; then
  export DSH_PORTABLE_ERROR="$OUTPUT"
  /usr/bin/osascript -e 'display dialog (system attribute "DSH_PORTABLE_ERROR") with title "DeepSeek-Herness" buttons {"Close"} default button "Close" with icon stop'
fi
exit $STATUS
